# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# BACKEND_URL: Base URL for the Indoor Delivery Bot backend server.
# Set this to your running backend host (e.g., https://indoor-delivery-bot.onrender.com)
BACKEND_URL=https://indoor-delivery-bot.onrender.com

